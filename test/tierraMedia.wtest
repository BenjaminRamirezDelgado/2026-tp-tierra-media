import src.tierraMedia.*

describe "Tests de Arsenal" {
    const enano = new Enano()
    const elfoGuerrero = new Elfo()
    const humano = new Humano()

    test "Espada con multiplicador de 15 y llevada por Enano otorga 300" {
        const espada = new Espada(multiplicador = 15)
        assert.equals(300, espada.poderOtorgado(enano))
    }

    test "Hacha con mango de 50 cm y hoja de 5 kg otorga 250" {
        const hacha = new Hacha(largoMango = 50, pesoHoja = 5)
        assert.equals(250, hacha.poderOtorgado(enano))
    }

    test "Espada con multiplicador de 10 llevada por Elfo otorga 250" {
        const espada = new Espada(multiplicador = 10)
        assert.equals(250, espada.poderOtorgado(elfoGuerrero))
    }

    test "Espada con multiplicador de 10 llevada por Humano otorga 150" {
        const espada = new Espada(multiplicador = 10)
        assert.equals(150, espada.poderOtorgado(humano))
    }

    test "Daga con multiplicador de 15 llevada por Enano otorga la mitad que la espada (150)" {
        const daga = new Daga(multiplicador = 15)
        assert.equals(150, daga.poderOtorgado(enano))
    }

    test "Baculo de 400 otorga 400 de poder" {
        const baculo = new Baculo(poder = 400)
        assert.equals(400, baculo.poderOtorgado(humano))
    }
}

describe "Tests de Guerreros" {
    const dagaDeFrodo = new Daga(multiplicador = 8)
    const frodo = new Hobbit(
        vidaActual = 50,
        armas = [dagaDeFrodo],
        elementos = []
    )

    const hachaDeGimli1 = new Hacha(largoMango = 70, pesoHoja = 5)
    const hachaDeGimli2 = new Hacha(largoMango = 70, pesoHoja = 5)
    const gimli = new Enano(
        vidaActual = 75,
        armas = [hachaDeGimli1, hachaDeGimli2],
        factorDePoder = 3
    )

    const espadaDeLegolas = new Espada(multiplicador = 12)
    const legolas = new Elfo(
        vidaActual = 80,
        destrezaPropia = 1,
        armas = [espadaDeLegolas]
    )

    const anduril = new Espada(multiplicador = 18)
    const dagaDeAragorn = new Daga(multiplicador = 10)
    const aragorn = new Humano(
        vidaActual = 85,
        armas = [anduril, dagaDeAragorn],
        limitadorDePoder = 20
    )

    const glamdring = new Espada(multiplicador = 10)
    const baculoDeGandalf = new Baculo(poder = 400)
    const gandalf = new Maiar(
        vidaActual = 100,
        armas = [glamdring, baculoDeGandalf]
    )

    test "Poder de Frodo (sin items)" {
        assert.equals(50, frodo.poder())
    }

    test "Poder de Gimli" {
        assert.equals(2175, gimli.poder())
    }

    test "Poder de Legolas" {
        elfo.destrezaBase(2)
        assert.equals(980, legolas.poder())
    }

    test "Poder de Aragorn" {
        assert.equals(102.25, aragorn.poder())
    }

    test "Poder de Gandalf" {
        assert.equals(2700, gandalf.poder())
    }

    test "Gandalf con 9 de vida, y todas sus armas" {
        gandalf.vidaActual(9)
        assert.equals(3900, gandalf.poder())
    }

    test "Poder de Legolas que obtiene medio punto de destreza propia" {
        elfo.destrezaBase(2)
        legolas.ganarDestreza(0.5)
        assert.equals(1130, legolas.poder())
    }

    test "Poder de Gollum es la mitad que el de un Hobbit con las mismas caracteristicas" {
        gollum.vidaActual(50)
        gollum.armas([dagaDeFrodo])
        gollum.elementos(["Anillo"])
        frodo.elementos(["Anillo"])
        assert.equals(90, frodo.poder())
        assert.equals(45, gollum.poder())
    }

    test "Poder de Tom Bombadil es diez millones" {
        assert.equals(10000000, tomBombadil.poder())
    }
}

describe "Tests de Los Caminos de la Tierra Media" {
    const hachaGimli = new Hacha(largoMango = 70, pesoHoja = 5)
    const gimli = new Enano(
        vidaActual = 75,
        armas = [hachaGimli, hachaGimli],
        factorDePoder = 3,
        elementos = ["Lembas", "Lembas", "Lembas"]
    )

    const glamdring = new Espada(multiplicador = 10)
    const baculoGandalf = new Baculo(poder = 400)
    const gandalf = new Maiar(
        vidaActual = 100,
        armas = [glamdring, baculoGandalf],
        elementos = ["Lembas", "Lembas"]
    )

    const frodo = new Hobbit(
        vidaActual = 50,
        armas = [new Daga(multiplicador = 8)],
        elementos = []
    )

    test "Un grupo cuyos integrantes superan 1500 de poder y estan armados puede atravesar Gondor" {
        const grupo = new Grupo(guerreros = [gimli, gandalf])
        assert.that(gondor.puedePasar(grupo))

        grupo.atravesar(gondor)
        assert.equals(65, gimli.vida())
        assert.equals(90, gandalf.vida())
    }

    test "Un grupo con un integrante debil no puede atravesar Gondor y lanza error al intentarlo" {
        const grupo = new Grupo(guerreros = [gimli, frodo])
        assert.notThat(gondor.puedePasar(grupo))
        assert.throwsException({ grupo.atravesar(gondor) })
    }

    test "Zona con requerimiento de elemento (Lembas) verifica la suma de elementos del grupo" {
        const zonaConLembas = new ZonaDePoder(
            poderMinimo = 1000,
            requerimiento = new RequerimientoDeElemento(cantidad = 5, elemento = "Lembas")
        )
        const grupo = new Grupo(guerreros = [gimli, gandalf])
        assert.that(zonaConLembas.puedePasar(grupo))

        const zonaConMuchasLembas = new ZonaDePoder(
            poderMinimo = 1000,
            requerimiento = new RequerimientoDeElemento(cantidad = 30, elemento = "Lembas")
        )
        assert.notThat(zonaConMuchasLembas.puedePasar(grupo))
    }

    test "Zona con requerimiento de guerrero se cumple si al menos un integrante del grupo lo verifica" {
        const guerreroCon3Armas = new Humano(
            vidaActual = 90,
            armas = [new Espada(multiplicador = 5), new Daga(multiplicador = 4), new Baculo(poder = 100)],
            limitadorDePoder = 1
        )
        const grupo = new Grupo(guerreros = [gimli, guerreroCon3Armas])

        const zonaMasDe2Armas = new ZonaArmada(
            vidaPerdida = 5,
            requerimiento = new RequerimientoMasDeArmas(cantidadMinima = 2)
        )
        assert.that(zonaMasDe2Armas.puedePasar(grupo))

        const zonaMasDe2000Poder = new ZonaArmada(
            vidaPerdida = 5,
            requerimiento = new RequerimientoMasDePoder(poderMinimo = 2000)
        )
        assert.that(zonaMasDe2000Poder.puedePasar(grupo))

        const zonaMasDe80Vida = new ZonaArmada(
            vidaPerdida = 5,
            requerimiento = new RequerimientoMasDeVida(vidaMinima = 80)
        )
        assert.that(zonaMasDe80Vida.puedePasar(grupo))
    }
}
